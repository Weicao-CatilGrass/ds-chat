{
  "name": "deepseek-chat",
  "version": "0.1.3",
  "description": "基于 DeepSeek API 的静态聊天客户端。",
  "author": "Weicao CatilGrass",
  "license": "MIT",
  "private": true,
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "rspack serve -c rspack.config.ts",
    "build": "node scripts/build.mjs",
    "type": "tsc -p tsconfig.json",
    "lint": "oxlint src rspack.config.ts electron scripts",
    "format": "oxfmt --write .",
    "electron:dev": "node scripts/electron-dev.mjs",
    "electron:build": "node scripts/build.mjs && electron-builder",
    "android:sync": "node scripts/build.mjs && cap sync android",
    "android:build": "node scripts/android-build.mjs",
    "release:meta": "node scripts/release-meta.mjs"
  },
  "dependencies": {
    "@capacitor/android": "8.6.2",
    "@capacitor/core": "8.6.2",
    "@types/katex": "^0.16.5",
    "@types/mdast": "~4.0.3",
    "@types/prismjs": "^1.26.1",
    "@types/react": "~18.3.1",
    "@types/react-dom": "~18.3.0",
    "clsx": "2.1.1",
    "fflate": "0.8.3",
    "idb": "8.0.3",
    "katex": "0.16.22",
    "mdast-util-find-and-replace": "3.0.2",
    "mdast-util-from-markdown": "2.0.3",
    "mdast-util-gfm": "3.1.0",
    "mdast-util-math": "3.0.0",
    "mermaid": "11.10.1",
    "micromark-extension-gfm": "3.0.0",
    "micromark-extension-llm-math": "3.1.0",
    "prismjs": "1.30.0",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "zustand": "4.4.7"
  },
  "devDependencies": {
    "@capacitor/cli": "8.6.2",
    "@rspack/cli": "2.0.2",
    "@rspack/core": "2.0.2",
    "@rspack/dev-server": "2.0.1",
    "@swc/helpers": "0.5.23",
    "@types/node": "~20.9.2",
    "electron": "43.3.0",
    "electron-builder": "26.18.0",
    "oxfmt": "0.48.0",
    "oxlint": "1.63.0",
    "typescript": "7.0.2"
  }
}
